# OpenAI API - for video transcription via Whisper
OPENAI_API_KEY=sk-proj-your-openai-api-key

# Anthropic API - for social post generation via Claude
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Supabase - PostgreSQL database for storing videos, transcripts, and posts
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# AWS S3 - for storing video files and processed media
AWS_S3_BUCKET=vom-video-to-posts-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Authentication & Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=7d

# GitHub OAuth - for user authentication
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=https://vom-video-to-posts.vercel.app/api/auth/github/callback

# Application Settings
NODE_ENV=production
APP_URL=https://vom-video-to-posts.vercel.app
API_RATE_LIMIT=100
MAX_VIDEO_SIZE_MB=500
VIDEO_PROCESSING_TIMEOUT=900

# Logging & Monitoring (Optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
LOG_LEVEL=info

# Email Notifications (Optional)
SENDGRID_API_KEY=your-sendgrid-api-key
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password

# Analytics (Optional)
POSTHOG_API_KEY=your-posthog-api-key
